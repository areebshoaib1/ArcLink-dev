# Arc RPC proxy (provided by Arc Studio)
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# WalletConnect (get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Circle developer credentials (for on-chain verification)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional: private key for self-deploy
DEPLOYER_PRIVATE_KEY=
